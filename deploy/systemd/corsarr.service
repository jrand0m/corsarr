# corsarr as a hardened systemd service for the native binary.
# Install: see README.md. Override locally with `systemctl edit corsarr`, never by editing
# this file in place (packages replace it on upgrade).
[Unit]
Description=corsarr media automation server
Documentation=https://github.com/jrand0m/corsarr
Wants=network-online.target
After=network-online.target
# Uncomment when media lives on a network mount, e.g. /srv/media:
# RequiresMountsFor=/srv/media

[Service]
Type=simple
User=corsarr
Group=corsarr
# Members of a shared media group can then read and write the library:
# SupplementaryGroups=media
ExecStart=/usr/bin/corsarr --configFile=/etc/corsarr/corsarr.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# /var/lib/corsarr (data.dir) is created and owned by the service user.
StateDirectory=corsarr
StateDirectoryMode=0750
ConfigurationDirectory=corsarr
UMask=0002

Environment=GOMEMLIMIT=96MiB
MemoryMax=256M
TasksMax=256

# Secrets: systemd hands them to the service under $CREDENTIALS_DIRECTORY; corsarr.yml
# references them as ${file:/run/credentials/corsarr.service/<name>}.
# LoadCredential=tmdb_api_key:/etc/corsarr/secrets/tmdb_api_key
# LoadCredential=qbit_password:/etc/corsarr/secrets/qbit_password

# Media: the only path outside the state directory corsarr may write. The leading "-"
# keeps the unit starting when the path is absent. Use ReadOnlyPaths= for shadow mode.
ReadWritePaths=-/srv/media

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
